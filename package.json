{
  "name": "max-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Digital Crew Max: the Max Agent API as MCP tools (Streamable HTTP) via Next.js and mcp-handler.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "digital-crew",
    "max",
    "next.js",
    "vercel"
  ],
  "homepage": "https://max.digitalcrew.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Digital-Crew-Technologies/max-mcp-server.git"
  },
  "bugs": {
    "url": "https://digitalcrew.tech/contact"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/verify-tools.mjs",
    "test:endpoints": "node scripts/test-endpoints.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:tools": "tsx scripts/gen-tool-docs.mts",
    "docs:check": "tsx scripts/gen-tool-docs.mts --check",
    "catalog:measure": "tsx scripts/measure-catalog.mts"
  },
  "dependencies": {
    "mcp-handler": "^1.1.0",
    "next": "^15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-config-next": "^15.2.6",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "fast-uri": "3.1.9",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "@babel/parser": "7.29.9",
      "@babel/types": "7.29.8",
      "@babel/helper-string-parser": "7.29.7",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "body-parser@2.4.0>qs": "6.16.1",
      "postcss@<8.5.18": "8.5.18",
      "hono@<4.12.25": "4.12.25",
      "ip-address@<10.3.1": "10.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5"
    }
  },
  "packageManager": "pnpm@8.15.7+sha512.c85cd21b6da10332156b1ca2aa79c0a61ee7ad2eb0453b88ab299289e9e8ca93e6091232b25c07cbf61f6df77128d9c849e5c9ac6e44854dbd211c49f3a67adc"
}
